# Copy to .env and fill in. .env is git-ignored.

# Free key, no credit card: https://console.groq.com
GROQ_API_KEY=gsk_...

# Models (overridable). Judge is a different lineage than the drafter on purpose.
LLM_MODEL=llama-3.3-70b-versatile
JUDGE_MODEL=openai/gpt-oss-120b

# Local embeddings (sentence-transformers) — downloaded on first use, no key.
EMBED_MODEL=BAAI/bge-small-en-v1.5

BRAND=Delta

# Kaggle (only for `make data`; or download twcs.csv manually into ./data/)
KAGGLE_USERNAME=
KAGGLE_KEY=
