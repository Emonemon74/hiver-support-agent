# Copy to .env and fill in. .env is git-ignored.

OPENAI_API_KEY=sk-...

# Models (overridable)
LLM_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o
EMBED_MODEL=text-embedding-3-small

# Chosen brand (set after Phase 2 profiling)
BRAND=

# Kaggle (only needed for `make data`; alternatively download twcs.csv manually)
KAGGLE_USERNAME=
KAGGLE_KEY=
